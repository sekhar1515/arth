# Required: random secret for signing session tokens. Generate with: openssl rand -base64 48
JWT_SECRET=
DB_PASSWORD=arth
# Local plain-http development needs non-secure cookies. Use true behind HTTPS.
COOKIE_SECURE=false
# Seeds a clearly labelled demo user with synthetic data (demo@arth.local). Set false for your real data.
DEMO_ENABLED=true
DEMO_PASSWORD=demo-password-2026
# Set to "ecs" or "logstash" for JSON logs
LOG_FORMAT=
# Recommended: key that encrypts two-step sign-in secrets. Generate with: openssl rand -base64 32
# (Without it, a key derived from JWT_SECRET is used, so rotating JWT_SECRET would switch off everyone's two-step sign-in.)
MFA_ENCRYPTION_KEY=
# Where links in notification e-mails point
PUBLIC_URL=http://localhost:3000
# Optional e-mail notifications. Leave SPRING_MAIL_HOST empty to keep e-mail off (in-app notifications still work).
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=
