# Production settings. Copy to .env on the server and fill in. Never commit the real .env.

# Your domain, already pointing (DNS A record) at this server's public IP. Caddy gets the HTTPS certificate itself.
DOMAIN=arth.example.com
# E-mail for Let's Encrypt expiry notices (recommended)
ACME_EMAIL=

# Secrets: generate each one fresh on the server
#   openssl rand -base64 48   -> JWT_SECRET
#   openssl rand -base64 32   -> MFA_ENCRYPTION_KEY
#   openssl rand -hex 24      -> DB_PASSWORD
JWT_SECRET=
MFA_ENCRYPTION_KEY=
DB_PASSWORD=

# Who can sign up: open (anyone), invite (needs the code) or closed (no new accounts)
REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=

# Keep false on a real server: the demo account's password is shown on the login page
DEMO_ENABLED=false

# Optional e-mail notifications (any SMTP provider). Leave SPRING_MAIL_HOST empty to keep e-mail off.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=
